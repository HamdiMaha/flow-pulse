# Copy to .env and fill in ONE of the two auth modes below, then run
# npm run dev. Without either, the AI Summary falls back to built-in
# rule-based text — the app runs fine either way.

# ---- Mode A: simple API key (most people) -----------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Mode B: Vertex AI service account ---------------------------------
# For work/managed Google Cloud orgs that don't issue simple API keys.
# GOOGLE_APPLICATION_CREDENTIALS = path to a service-account JSON key file
# (Google Cloud Console -> IAM & Admin -> Service Accounts -> Keys).
# GOOGLE_CLOUD_PROJECT = that JSON file's "project_id".
# Only used when GEMINI_API_KEY above is empty.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Optional, either mode (default shown):
# GEMINI_MODEL=gemini-2.0-flash
