# Copy to .env and fill in your key:
#   cp .env.example .env
#
# Free Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional (defaults shown):
# GEMINI_MODEL=gemini-2.0-flash

# Without a key the AI Summary falls back to built-in rule-based text —
# the app runs fine either way.
